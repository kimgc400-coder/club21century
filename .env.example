# 이 파일을 복사해 .env 로 만든 뒤 실제 값을 채우면 된다.
# Windows:  copy .env.example .env
# Mac/Linux: cp .env.example .env

# 로컬 MySQL 스키마 이름
# 미리 실행:
#   CREATE DATABASE club21century DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE DATABASE club21century_test DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_NAME=club21century

# MySQL 접속 계정
DB_USERNAME=root
DB_PASSWORD=